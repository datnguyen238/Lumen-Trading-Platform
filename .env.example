# Vercel project environment. Keep real values in Vercel, never in this file.
# Copy the EXACT Transaction pooler URI from Supabase > Connect (port 6543).
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Include the exact HTTPS production/custom origin; preview VERCEL_URL is added automatically.
FRONTEND_ORIGINS=https://YOUR_PROJECT.vercel.app
PAPER_WORKER_ENABLED=true
PAPER_WORKER_INTERVAL_SECONDS=30
PAPER_WORKER_SYMBOL_LIMIT=30
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
# Optional. Used only by the explicit bootstrap command, never by browser requests.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Vercel sets VERCEL and VERCEL_URL automatically. Do not set them manually there.
