# Local development. Use a Supabase session pooler URI or a local PostgreSQL database.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lumen_trading
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PAPER_WORKER_ENABLED=true
DATABASE_AUTO_SETUP=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
YFINANCE_WS_ENABLED=false
LIVE_PRICE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=300
LIVE_BULK_LIMIT=50
# Optional for a local HTTPS setup. Vercel always uses secure cookies automatically.
SESSION_COOKIE_SECURE=false
